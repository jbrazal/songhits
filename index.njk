---
layout: base.njk
title: SongHits
---
<style>
  #home-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 28px 24px 60px;
  }

  .home-section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--section);
    margin: 0 0 14px;
    padding-bottom: 4px;
    border-bottom: 1px solid #1e1e1e;
  }

  /* ── Setlists ─────────────────────────────────────────────── */
  .setlist-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .setlist-card {
    background: #111;
    border: 1px solid #222;
    border-radius: 6px;
    padding: 12px 18px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.12s;
  }
  .setlist-card:hover { border-color: var(--blue); text-decoration: none; }
  .setlist-card-name { font-size: 14px; font-weight: 700; color: var(--red); }
  .setlist-card-count { font-size: 11px; color: var(--muted); margin-top: 2px; }

  /* ── Songs ────────────────────────────────────────────────── */
  .songs-filter {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  #song-search {
    background: #111;
    border: 1px solid #222;
    color: var(--text);
    padding: 6px 12px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 13px;
    width: 260px;
    outline: none;
  }
  #song-search:focus { border-color: var(--blue); }
  #song-search::placeholder { color: #444; }

  .songs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 8px;
  }
  .song-card {
    background: #0e0e0e;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    padding: 9px 13px;
    text-decoration: none;
    display: block;
    transition: border-color 0.1s;
  }
  .song-card:hover { border-color: #333; text-decoration: none; }
  .song-card-title  { color: var(--text); font-size: 13px; font-weight: 600; line-height: 1.3; }
  .song-card-artist { color: var(--muted); font-size: 11px; margin-top: 2px; }
  .song-card.hidden { display: none; }
</style>

<div id="home-wrap">

  {% if collections.setlists.length %}
  <div class="home-section-title">Setlists</div>
  <div class="setlist-cards">
    {% for sl in collections.setlists %}
    <a class="setlist-card" href="{{ sl.url }}">
      <div class="setlist-card-name">{{ sl.data.title }}</div>
      <div class="setlist-card-count">{{ sl.data.parts | countSongs }} songs</div>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  <div class="home-section-title">Songs</div>
  <div class="songs-filter">
    <input id="song-search" type="search" placeholder="Filter songs…" autocomplete="off">
  </div>
  <div class="songs-grid" id="songs-grid">
    {% for song in collections.songs %}
    <a class="song-card" href="{{ song.url }}"
       data-title="{{ song.data.title | lower }}"
       data-artist="{{ song.data.artist | lower }}">
      <div class="song-card-title">{{ song.data.title }}</div>
      {% if song.data.artist %}<div class="song-card-artist">{{ song.data.artist }}</div>{% endif %}
    </a>
    {% endfor %}
  </div>

</div>

<script>
  document.getElementById('song-search').addEventListener('input', function () {
    var q = this.value.trim().toLowerCase();
    document.querySelectorAll('.song-card').forEach(function (el) {
      var match = !q || el.dataset.title.includes(q) || el.dataset.artist.includes(q);
      el.classList.toggle('hidden', !match);
    });
  });
</script>
