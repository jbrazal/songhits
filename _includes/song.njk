---
layout: base.njk
---
<style>
  #song-toolbar {
    position: sticky;
    top: 44px;
    z-index: 400;
    background: #0e0e0e;
    border-bottom: 1px solid #1e1e1e;
    padding: 7px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }
  #song-toolbar .song-heading {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #song-toolbar .song-heading strong { color: #e8e8e8; font-size: 14px; }
  #song-toolbar .song-heading span   { color: var(--muted); font-size: 12px; margin-left: 6px; }
  #transpose-val {
    display: inline-block;
    width: 28px;
    text-align: center;
    font-weight: 700;
    color: var(--chord);
    font-size: 13px;
  }
  .ctrl-btn-wide {
    width: auto;
    padding: 0 10px;
    font-size: 11px;
  }
  #song-body {
    padding: 28px 32px 80px;
    max-width: 960px;
  }
  #cm-error {
    background: #3a1010;
    border: 1px solid #7a3030;
    color: #f48771;
    border-radius: 4px;
    padding: 10px 14px;
    margin-bottom: 16px;
    font-size: 13px;
    white-space: pre-wrap;
  }
  #cm-raw {
    white-space: pre-wrap;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  /* ── Docked controls ──────────────────────────────────────── */
  #scroll-controls {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50px;
    background: #0a0a0a;
    border-top: 1px solid #1e1e1e;
    padding: 0 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 9999;
    font-size: 13px;
  }

  #btn-play {
    background: var(--section);
    color: #000;
    border: none;
    padding: 5px 16px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    min-width: 86px;
    transition: background 0.12s;
    flex-shrink: 0;
  }
  #btn-play.playing { background: var(--red); }

  #speed-slider { width: 88px; accent-color: var(--chord); cursor: pointer; }
  #speed-val    { color: var(--chord); font-weight: 700; font-family: monospace; min-width: 2.6em; flex-shrink: 0; }

  #btn-top {
    margin-left: auto;
    background: none;
    border: 1px solid #222;
    color: #444;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    flex-shrink: 0;
  }
  #btn-top:hover { background: #181818; color: #aaa; }

  .zoom-val {
    color: var(--chord);
    font-weight: 700;
    font-family: monospace;
    font-size: 12px;
    min-width: 3em;
    text-align: center;
    flex-shrink: 0;
  }

  @media print {
    nav, #song-toolbar, #scroll-controls { display: none; }
    #song-body { padding: 0; }
    .cmSection { page-break-inside: avoid; }
    @page { margin: 1.5cm 2cm; size: A4 portrait; }
  }
</style>

<div id="song-toolbar">
  <div class="song-heading">
    <strong>{{ title }}</strong>{% if artist %}<span>— {{ artist }}</span>{% endif %}
  </div>
  <span class="ctrl-label">Transpose</span>
  <button class="ctrl-btn" id="btn-down" title="Transpose down (,)">▼</button>
  <span id="transpose-val">0</span>
  <button class="ctrl-btn" id="btn-up"   title="Transpose up (.)">▲</button>
  <button class="ctrl-btn" id="btn-reset" title="Reset (0)" style="font-size:13px">↺</button>
  <div class="toolbar-sep"></div>
  <button class="ctrl-btn ctrl-btn-wide" id="btn-pdf" title="Print / Save as PDF">PDF</button>
</div>

<div id="song-body">
  <div id="cm-error" style="display:none"></div>
  <div id="cm-content" class="cmSong"></div>
  <div id="cm-raw"    style="display:none"></div>
</div>

<div id="scroll-controls">
  <button id="btn-play">▶ Play</button>
  <div class="toolbar-sep"></div>
  <span class="ctrl-label">Speed</span>
  <button class="ctrl-btn" id="btn-slower">−</button>
  <input type="range" id="speed-slider" min="0.2" max="8" step="0.1" value="1.5">
  <button class="ctrl-btn" id="btn-faster">+</button>
  <span id="speed-val">1.5</span>
  <div class="toolbar-sep"></div>
  <span class="ctrl-label">Size</span>
  <button class="ctrl-btn" id="btn-zoom-out">−</button>
  <span class="zoom-val" id="size-val">14px</span>
  <button class="ctrl-btn" id="btn-zoom-in">+</button>
  <button id="btn-top">⬆ Top</button>
</div>

<script src="/assets/chord-mark.js"></script>
<script>
(function () {
  const chordMark = window['chord-mark'];
  const SOURCE = {{ content | dump | safe }};
  let transpose = 0;

  function fmt(v) { return v > 0 ? '+' + v : String(v); }

  function render() {
    const content = document.getElementById('cm-content');
    const errEl   = document.getElementById('cm-error');
    const rawEl   = document.getElementById('cm-raw');
    try {
      const parsed = chordMark.parseSong(SOURCE);
      content.innerHTML = chordMark.renderSong(parsed, {
        transposeValue:      transpose,
        alignBars:           true,
        printBarSeparators:  'always',
        printChordsDuration: 'uneven',
      });
      errEl.style.display   = 'none';
      rawEl.style.display   = 'none';
      content.style.display = '';
    } catch (e) {
      errEl.textContent    = 'Parse error: ' + (e && e.message ? e.message : String(e));
      errEl.style.display  = 'block';
      rawEl.textContent    = SOURCE;
      rawEl.style.display  = 'block';
      content.style.display = 'none';
    }
    document.getElementById('transpose-val').textContent = fmt(transpose);
  }

  document.getElementById('btn-up').onclick    = () => { transpose = Math.min(11, transpose + 1);  render(); };
  document.getElementById('btn-down').onclick  = () => { transpose = Math.max(-11, transpose - 1); render(); };
  document.getElementById('btn-reset').onclick = () => { transpose = 0; render(); };
  document.getElementById('btn-pdf').onclick   = () => window.print();

  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT') return;
    if (e.key === '.')        { transpose = Math.min(11, transpose + 1);  render(); }
    else if (e.key === ',')   { transpose = Math.max(-11, transpose - 1); render(); }
    else if (e.key === '0')   { transpose = 0; render(); }
    else if (e.key === ' ')   { e.preventDefault(); playing ? stopScroll() : startScroll(); }
    else if (e.key === 'ArrowUp')   { e.preventDefault(); setSpeed(speed + 0.5); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); setSpeed(speed - 0.5); }
    else if (e.key === '+' || e.key === '=') { e.preventDefault(); zi = Math.min(SIZES.length - 1, zi + 1); applyZoom(); }
    else if (e.key === '-')         { e.preventDefault(); zi = Math.max(0, zi - 1); applyZoom(); }
    else if (e.key === 'Home')      { e.preventDefault(); stopScroll(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });

  render();

  // ── Autoscroll ──────────────────────────────────────────────
  let playing = false, speed = 1.5, raf = null, lastTime = null, carry = 0;

  function tick(ts) {
    if (!playing) return;
    if (lastTime !== null) {
      const dt = ts - lastTime;
      carry += speed * dt * 0.045;
      const px = Math.floor(carry);
      if (px > 0) { window.scrollBy(0, px); carry -= px; }
    }
    lastTime = ts;
    if (window.scrollY + window.innerHeight >= document.body.scrollHeight - 2) { stopScroll(); return; }
    raf = requestAnimationFrame(tick);
  }

  function startScroll() {
    playing = true; lastTime = null; carry = 0;
    document.getElementById('btn-play').textContent = '⏸ Pause';
    document.getElementById('btn-play').classList.add('playing');
    raf = requestAnimationFrame(tick);
  }

  function stopScroll() {
    playing = false;
    cancelAnimationFrame(raf); lastTime = null;
    document.getElementById('btn-play').textContent = '▶ Play';
    document.getElementById('btn-play').classList.remove('playing');
  }

  function setSpeed(val) {
    speed = Math.round(Math.max(0.2, Math.min(8, +val)) * 10) / 10;
    document.getElementById('speed-slider').value = speed;
    document.getElementById('speed-val').textContent = speed.toFixed(1);
  }

  document.getElementById('btn-play').onclick    = () => playing ? stopScroll() : startScroll();
  document.getElementById('btn-slower').onclick  = () => setSpeed(speed - 0.5);
  document.getElementById('btn-faster').onclick  = () => setSpeed(speed + 0.5);
  document.getElementById('speed-slider').oninput = function () { setSpeed(parseFloat(this.value)); };
  document.getElementById('btn-top').onclick     = () => { stopScroll(); window.scrollTo({ top: 0, behavior: 'smooth' }); };

  // ── Font size ────────────────────────────────────────────────
  const SIZES = [10, 11, 12, 13, 14, 16, 18, 20, 22, 24, 28];
  let zi = 4;
  function applyZoom() {
    const px = SIZES[zi];
    document.getElementById('song-body').style.fontSize = px + 'px';
    document.getElementById('size-val').textContent = px + 'px';
  }
  document.getElementById('btn-zoom-out').onclick = () => { zi = Math.max(0, zi - 1); applyZoom(); };
  document.getElementById('btn-zoom-in').onclick  = () => { zi = Math.min(SIZES.length - 1, zi + 1); applyZoom(); };

  setSpeed(speed);
  applyZoom();
})();
</script>
