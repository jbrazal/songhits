---
layout: base.njk
---
<style>
  #song-toolbar {
    position: sticky;
    top: 44px;
    z-index: 400;
    background: #0e0e0e;
    border-bottom: 1px solid #1e1e1e;
    padding: 7px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }
  #song-toolbar .song-heading {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #song-toolbar .song-heading strong { color: #e8e8e8; font-size: 14px; }
  #song-toolbar .song-heading span   { color: var(--muted); font-size: 12px; margin-left: 6px; }
  #transpose-val {
    display: inline-block;
    width: 28px;
    text-align: center;
    font-weight: 700;
    color: var(--chord);
    font-size: 13px;
  }
  .ctrl-btn-wide {
    width: auto;
    padding: 0 10px;
    font-size: 11px;
  }
  #song-body {
    padding: 28px 32px calc(var(--scroll-h, 50px) + 24px);
    max-width: 960px;
  }
  #cm-error {
    background: #3a1010;
    border: 1px solid #7a3030;
    color: #f48771;
    border-radius: 4px;
    padding: 10px 14px;
    margin-bottom: 16px;
    font-size: 13px;
    white-space: pre-wrap;
  }
  #cm-raw {
    white-space: pre-wrap;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  /* ── Docked controls ──────────────────────────────────────── */
  #scroll-controls {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50px;
    background: #0a0a0a;
    border-top: 1px solid #1e1e1e;
    padding: 0 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 9999;
    font-size: 13px;
  }

  #btn-play {
    background: var(--section);
    color: #000;
    border: none;
    padding: 5px 16px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    min-width: 86px;
    transition: background 0.12s;
    flex-shrink: 0;
  }
  #btn-play.playing { background: var(--red); }

  #speed-slider { width: 88px; accent-color: var(--chord); cursor: pointer; }
  #speed-val    { color: var(--chord); font-weight: 700; font-family: monospace; min-width: 2.6em; flex-shrink: 0; white-space: nowrap; }

  #btn-top {
    margin-left: auto;
    background: none;
    border: 1px solid #222;
    color: #444;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    flex-shrink: 0;
  }
  #btn-top:hover { background: #181818; color: #aaa; }

  .zoom-val {
    color: var(--chord);
    font-weight: 700;
    font-family: monospace;
    font-size: 12px;
    min-width: 3em;
    text-align: center;
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    #song-toolbar, #scroll-controls { flex-wrap: wrap; height: auto; padding: 7px 10px; gap: 6px; }
    #song-toolbar .song-heading { flex: 1 0 100%; }
    .ctrl-label, .toolbar-sep { display: none; }
    #song-body { padding-left: 12px; padding-right: 12px; overflow-x: auto; }
    .ctrl-btn { width: 32px; height: 32px; }
  }
  @media print {
    nav, #song-toolbar, #scroll-controls { display: none; }
    #song-body { padding: 0; }
    .cmSection { page-break-inside: avoid; }
    @page { margin: 1.5cm 2cm; size: A4 portrait; }
  }
</style>

<div id="song-toolbar">
  <div class="song-heading">
    <strong>{{ title }}</strong>{% if artist %}<span>— {{ artist }}</span>{% endif %}
  </div>
  <span id="tempo-blinker" title=""></span>
  <div class="toolbar-sep"></div>
  <span class="ctrl-label">Transpose</span>
  <button class="ctrl-btn" id="btn-down" title="Transpose down (,)">▼</button>
  <span id="transpose-val">0</span>
  <button class="ctrl-btn" id="btn-up"   title="Transpose up (.)">▲</button>
  <button class="ctrl-btn" id="btn-reset" title="Reset (0)" style="font-size:13px">↺</button>
  <div class="toolbar-sep"></div>
  <select id="sel-font" class="pref-select" title="Chart font"></select>
  <select id="sel-symbol" class="pref-select" title="Symbol type">
    <option value="chord">Chord Symbols</option>
    <option value="roman">Roman Numerals</option>
  </select>
  <select id="sel-chart" class="pref-select" title="Chart type">
    <option value="all">Show Everything</option>
    <option value="lyrics">Lyrics Only</option>
    <option value="chords">Chords Only</option>
    <option value="chordsFirstLyricLine">Chords + First Line</option>
  </select>
  <div class="toolbar-sep"></div>
  <button class="ctrl-btn ctrl-btn-wide" id="btn-pdf" title="Print / Save as PDF">PDF</button>
</div>

<div id="song-body" data-slug="{{ page.fileSlug | escape }}" data-tempo="{{ tempo }}">
  <div id="cm-error" style="display:none"></div>
  <div id="cm-content" class="cmSong"></div>
  <div id="cm-raw"    style="display:none"></div>
</div>

<div id="scroll-controls">
  <button id="btn-play">▶ Play</button>
  <div class="toolbar-sep"></div>
  <span class="ctrl-label" id="speed-label">Speed</span>
  <button class="ctrl-btn" id="btn-slower" aria-label="Slower">−</button>
  <input type="range" id="speed-slider" aria-label="Autoscroll speed" min="0.2" max="8" step="0.1" value="1.5">
  <button class="ctrl-btn" id="btn-faster" aria-label="Faster">+</button>
  <span id="speed-val">1.5</span>
  <button class="ctrl-btn" id="btn-speed-reset" title="Reset speed or tempo" aria-label="Reset speed or tempo" style="font-size:13px">↺</button>
  <div class="toolbar-sep"></div>
  <span class="ctrl-label">Size</span>
  <button class="ctrl-btn" id="btn-zoom-out" aria-label="Decrease chart size">−</button>
  <span class="zoom-val" id="size-val">14px</span>
  <button class="ctrl-btn" id="btn-zoom-in" aria-label="Increase chart size">+</button>
  <button id="btn-top">⬆ Top</button>
</div>

<script id="song-source" type="application/json">{{ content | dump | escapeScriptJson | safe }}</script>
<script src="{{ '/assets/chord-mark.js' | url }}"></script>
<script src="{{ '/assets/site-controls.js' | url }}"></script>
<script src="{{ '/assets/song.js' | url }}"></script>
