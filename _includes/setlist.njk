---
layout: base.njk
---
<style>
  /* ── Layout ───────────────────────────────────────────────── */
  :root { --toc-w: 210px; --ctrl-h: 48px; }

  /* ── Controls bar – fixed below nav ──────────────────────── */
  #controls {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    height: var(--ctrl-h);
    background: #0a0a0a;
    border-bottom: 1px solid #1e1e1e;
    padding: 0 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 9999;
    font-size: 13px;
  }

  /* ── TOC toggle button ───────────────────────────────────── */
  #btn-toc {
    background: none;
    border: 1px solid #1e1e1e;
    color: #555;
    padding: 4px 9px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    flex-shrink: 0;
    transition: color 0.1s, border-color 0.1s, background 0.1s;
  }
  #btn-toc:hover { background: #181818; color: #aaa; border-color: #333; }
  #btn-toc.active { color: var(--chord); border-color: #333; }

  #btn-toggle {
    background: var(--section);
    color: #000;
    border: none;
    padding: 5px 16px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    min-width: 86px;
    transition: background 0.12s;
    flex-shrink: 0;
  }
  #btn-toggle.playing { background: var(--red); }

  #speed-slider { width: 88px; accent-color: var(--chord); cursor: pointer; }
  #speed-val    { color: var(--chord); font-weight: 700; font-family: monospace; min-width: 2.6em; flex-shrink: 0; }

  #btn-top {
    margin-left: auto;
    background: none;
    border: 1px solid #222;
    color: #444;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    flex-shrink: 0;
  }
  #btn-top:hover { background: #181818; color: #aaa; }

  .zoom-val {
    color: var(--chord);
    font-weight: 700;
    font-family: monospace;
    font-size: 12px;
    min-width: 3em;
    text-align: center;
    flex-shrink: 0;
  }

  /* ── TOC sidebar ──────────────────────────────────────────── */
  #toc-sidebar {
    position: fixed;
    top: calc(var(--nav-h) + var(--ctrl-h));
    left: 0;
    width: var(--toc-w);
    bottom: 0;
    overflow-y: auto;
    background: #080808;
    border-right: 1px solid #1a1a1a;
    padding: 14px 0;
    z-index: 100;
    scrollbar-width: thin;
    scrollbar-color: #222 transparent;
    transition: transform 0.2s ease;
  }
  #toc-sidebar::-webkit-scrollbar { width: 4px; }
  #toc-sidebar::-webkit-scrollbar-thumb { background: #222; border-radius: 2px; }

  .toc-part-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #333;
    padding: 10px 14px 4px;
  }
  .toc-part-label:first-child { padding-top: 2px; }

  #toc-sidebar ul { list-style: none; counter-reset: toc-n; }
  #toc-sidebar li { counter-increment: toc-n; }
  #toc-sidebar a,
  #toc-sidebar .toc-tbd {
    display: block;
    padding: 3px 14px 3px 10px;
    font-size: 12px;
    line-height: 1.35;
    color: #444;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.1s, border-color 0.1s;
  }
  #toc-sidebar a::before,
  #toc-sidebar .toc-tbd::before {
    content: counter(toc-n) ". ";
    font-size: 10px;
    color: #2a2a2a;
    margin-right: 2px;
  }
  #toc-sidebar a:hover { color: #888; text-decoration: none; }
  #toc-sidebar a.active { color: var(--chord); border-left-color: var(--chord); }
  #toc-sidebar .toc-tbd { color: #2a2a2a; font-style: italic; }

  /* Desktop: collapse TOC */
  body.toc-off #toc-sidebar { transform: translateX(-100%); pointer-events: none; }
  body.toc-off #setlist-wrap { margin-left: 0; }

  /* ── Mobile overlay backdrop ─────────────────────────────── */
  #toc-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 150;
    cursor: pointer;
  }

  /* ── Main content ─────────────────────────────────────────── */
  #setlist-wrap {
    margin-left: var(--toc-w);
    padding: calc(var(--ctrl-h) + 20px) 40px 60px 32px;
    font-size: 14px;
    transition: margin-left 0.2s ease;
  }

  .setlist-title {
    color: var(--red);
    font-size: 1.4em;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 28px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--red);
  }

  .song-block { margin-bottom: 48px; }
  .song-block-header {
    position: sticky;
    top: calc(var(--nav-h) + var(--ctrl-h));
    z-index: 40;
    background: var(--bg);
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
    padding: 6px 0;
    border-bottom: 1px solid #1a1a1a;
  }
  .song-block-title  { color: var(--red); font-size: 1.05em; font-weight: 700; }
  .song-block-artist { color: var(--muted); font-size: 12px; }

  .chart-pending    { color: #333; font-style: italic; font-size: 13px; padding: 8px 0; }
  .cm-raw-fallback  { white-space: pre-wrap; color: var(--muted); font-size: 13px; }

  /* ── Narrow screens ───────────────────────────────────────── */
  @media (max-width: 680px) {
    :root { --ctrl-h: 84px; }

    body { overflow-x: hidden; }

    #controls {
      flex-wrap: wrap;
      height: auto;
      padding: 7px 10px;
      gap: 5px;
      align-content: center;
    }
    .ctrl-label { display: none; }
    .toolbar-sep { display: none; }
    #btn-toggle { min-width: 72px; font-size: 12px; padding: 5px 10px; }
    #speed-slider { width: 70px; }
    #speed-val { min-width: 2.2em; font-size: 12px; }
    .zoom-val { min-width: 2.6em; font-size: 12px; }
    .ctrl-btn { width: 32px; height: 32px; font-size: 13px; }

    /* TOC as slide-in overlay drawer */
    #toc-sidebar {
      width: 75%;
      max-width: 260px;
      transform: translateX(-100%);
      z-index: 200;
      box-shadow: 4px 0 20px rgba(0,0,0,0.7);
    }
    body.toc-on #toc-sidebar { transform: translateX(0); pointer-events: auto; }
    body.toc-on #toc-overlay { display: block; }

    #setlist-wrap {
      margin-left: 0;
      padding: calc(var(--ctrl-h) + 12px) 14px 40px;
    }
    body.toc-off #setlist-wrap { margin-left: 0; }

    .cm-song-content { overflow-x: auto; }
  }

  .transpose-control { font-size: 12px; color: var(--text); margin-left: auto; }
  #offline-status { font-size: 11px; }
  .ctrl-btn-wide { width: auto; padding: 0 8px; }
  #controls { flex-wrap: wrap; height: auto; min-height: 48px; padding-top: 7px; padding-bottom: 7px; }
  .song-block-header { flex-wrap: wrap; }
  .song-block { scroll-margin-top: calc(var(--nav-h) + var(--ctrl-h) + 12px); }
  /* ── Print ────────────────────────────────────────────────── */
  @media print {
    nav, #toc-sidebar, #controls, #toc-overlay, .transpose-control { display: none !important; }
    #setlist-wrap { margin: 0; padding: 0; }
    .song-block { page-break-inside: avoid; }
    @page { margin: 1.5cm 2cm; size: A4 portrait; }
  }
</style>

{# ── Mobile overlay backdrop ─────────────────────────────────── #}
<div id="toc-overlay"></div>

{# ── Floating sidebar TOC ─────────────────────────────────────── #}
<aside id="toc-sidebar">
  {% for part in parts %}
  {% set partIndex = loop.index %}
  <div class="toc-part-label">{{ part.name }}</div>
  <ul>
    {% for song in part.songs %}
    <li>
      {% if song.slug %}
        <a href="#song-{{ partIndex }}-{{ loop.index }}">{{ song.title }}</a>
      {% else %}
        <span class="toc-tbd">{{ song.title }}</span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endfor %}
</aside>

{# ── Main content ─────────────────────────────────────────────── #}
<div id="setlist-wrap" data-setlist="{{ page.filePathStem | replace('/setlist/', '') | replace('/index', '') | escape }}">
  <h1 class="setlist-title">{{ title }}</h1>

  {% for part in parts %}
  {% set partIndex = loop.index %}
    {% for song in part.songs %}
    <div class="song-block" id="song-{{ partIndex }}-{{ loop.index }}" data-slug="{{ song.slug | default('') | escape }}" data-transpose="{{ song.transpose | default(0) }}">
      <div class="song-block-header">
        <span class="song-block-title">{{ song.title }}</span>
        {% if song.slug %}<label class="transpose-control">Transpose <select class="song-transpose pref-select" aria-label="Transpose {{ song.title | escape }}"></select></label>{% endif %}
        {% if song.artist %}<span class="song-block-artist">— {{ song.artist }}</span>{% endif %}
      </div>
      {% if song.slug %}
        <div class="cm-song-content cmSong" data-slug="{{ song.slug }}"></div>
      {% else %}
        <p class="chart-pending">{% if song.tbd %}TBD{% else %}Chart coming soon{% endif %}</p>
      {% endif %}
    </div>
    {% endfor %}
  {% endfor %}
</div>

{# ── Controls bar (top, below nav) ────────────────────────────── #}
<div id="controls">
  <button id="btn-toc" title="Toggle song list" aria-label="Toggle song list" aria-controls="toc-sidebar" aria-expanded="false">☰</button>
  <div class="toolbar-sep"></div>
  <span id="tempo-blinker" title=""></span>
  <div class="toolbar-sep"></div>
  <button id="btn-toggle">▶ Play</button>
  <div class="toolbar-sep"></div>
  <span class="ctrl-label">Speed</span>
  <button class="ctrl-btn" id="btn-slower" aria-label="Scroll slower">−</button>
  <input type="range" id="speed-slider" aria-label="Autoscroll speed" min="0.2" max="8" step="0.1" value="1.5">
  <button class="ctrl-btn" id="btn-faster" aria-label="Scroll faster">+</button>
  <span id="speed-val">1.5</span>
  <div class="toolbar-sep"></div>
  <span class="ctrl-label">Size</span>
  <button class="ctrl-btn" id="btn-zoom-out" aria-label="Decrease chart size">−</button>
  <span class="zoom-val" id="zoom-val">14px</span>
  <button class="ctrl-btn" id="btn-zoom-in" aria-label="Increase chart size">+</button>
  <div class="toolbar-sep"></div>
  <select id="sel-font" class="pref-select" title="Chart font"></select>
  <select id="sel-symbol" class="pref-select" title="Symbol type">
    <option value="chord">Chord Symbols</option>
    <option value="roman">Roman Numerals</option>
  </select>
  <select id="sel-chart" class="pref-select" title="Chart type">
    <option value="all">Show Everything</option>
    <option value="lyrics">Lyrics Only</option>
    <option value="chords">Chords Only</option>
    <option value="chordsFirstLyricLine">Chords + First Line</option>
  </select>
  <button class="ctrl-btn ctrl-btn-wide" id="btn-pdf" title="Print / Save as PDF">PDF</button>
  <button class="ctrl-btn ctrl-btn-wide" id="btn-offline">Save offline</button>
  <span id="offline-status" role="status"></span>
  <button id="btn-top">⬆ Top</button>
</div>

<script id="setlist-sources" type="application/json">{% setlistSongsJson parts %}</script>
<script id="setlist-tempos" type="application/json">{% setlistTemposJson parts %}</script>
<script src="{{ '/assets/chord-mark.js' | url }}"></script>
<script src="{{ '/assets/site-controls.js' | url }}"></script>
<script src="{{ '/assets/setlist.js' | url }}"></script>
