<div id="prompter-bar" role="toolbar" aria-label="Teleprompter controls">
  <div class="prompter-row">
    <button type="button" class="prompter-btn prompter-play" data-prompter="play" data-play-mirror aria-pressed="false">▶ Play</button>
    <label class="prompter-pace" for="prompter-speed-slider">Pace</label>
    <input type="range" id="prompter-speed-slider" aria-label="Scroll pace" min="0.2" max="8" step="0.1" value="0.6">
    <output id="prompter-speed-val" for="prompter-speed-slider">0.6×</output>
  </div>
  <div class="prompter-row prompter-row-tools">
    <span class="prompter-hint">Swipe to reposition. Play continues from there.</span>
    <button type="button" class="prompter-btn" data-prompter="smaller" aria-label="Smaller text">A−</button>
    <button type="button" class="prompter-btn" data-prompter="larger" aria-label="Larger text">A+</button>
    <button type="button" class="prompter-btn prompter-exit" data-prompter="exit">Exit</button>
  </div>
</div>
