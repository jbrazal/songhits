---
layout: base.njk
title: Songs
permalink: /songs/
---
<style>
  #songs-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 28px 24px 60px;
  }

  .songs-filter {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  #song-search {
    background: #111;
    border: 1px solid #222;
    color: var(--text);
    padding: 6px 12px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 13px;
    width: 260px;
    outline: none;
  }
  #song-search:focus { border-color: var(--blue); }
  #song-search::placeholder { color: #444; }
  #song-count { font-size: 12px; color: var(--muted); }

  .songs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 8px;
  }
  .song-card {
    background: #0e0e0e;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    padding: 9px 13px;
    text-decoration: none;
    display: block;
    transition: border-color 0.1s;
  }
  .song-card:hover { border-color: #333; text-decoration: none; }
  .song-card-title  { color: var(--text); font-size: 13px; font-weight: 600; line-height: 1.3; }
  .song-card-artist { color: var(--muted); font-size: 11px; margin-top: 2px; }
  .song-card.hidden { display: none; }
</style>

<div id="songs-wrap">
  <div class="songs-filter">
    <input id="song-search" type="search" placeholder="Filter songs…" autocomplete="off">
    <span id="song-count"></span>
  </div>
  <div class="songs-grid" id="songs-grid">
    {% for song in collections.songs %}
    <a class="song-card" href="{{ song.url | url }}"
       data-title="{{ song.data.title | lower }}"
       data-artist="{{ song.data.artist | lower }}">
      <div class="song-card-title">{{ song.data.title }}</div>
      {% if song.data.artist %}<div class="song-card-artist">{{ song.data.artist }}</div>{% endif %}
    </a>
    {% endfor %}
  </div>
</div>

<script>
(function () {
  var search = document.getElementById('song-search');
  var cards  = document.querySelectorAll('.song-card');
  var count  = document.getElementById('song-count');
  var total  = cards.length;

  function update() {
    var q = search.value.trim().toLowerCase();
    var shown = 0;
    cards.forEach(function (el) {
      var match = !q || el.dataset.title.includes(q) || el.dataset.artist.includes(q);
      el.classList.toggle('hidden', !match);
      if (match) shown++;
    });
    count.textContent = q ? shown + ' of ' + total : total + ' songs';
  }

  search.addEventListener('input', update);
  update();
})();
</script>
